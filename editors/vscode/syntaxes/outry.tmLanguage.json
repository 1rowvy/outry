{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Outry",
  "scopeName": "source.outry",
  "comment": "Approximate, for colour only: the format's rules live in outry-core/src/lang/parse.rs. Keep in step with app/src/outryLanguage.ts and editors/tree-sitter-outry.",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#request-line"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#fields"
    },
    {
      "include": "#expression"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.outry",
          "match": "//.*$"
        },
        {
          "name": "comment.block.outry",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "request-line": {
      "comment": "Login: GET /users/{id} {  — optional name, method, then the path up to a block or the end of the line",
      "begin": "^\\s*(?:([\\p{L}_][\\p{L}\\p{N}_]*)(:)\\s+)?([A-Z]{2,})(?=\\s|$)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.function.outry"
        },
        "2": {
          "name": "punctuation.separator.key-value.outry"
        },
        "3": {
          "name": "keyword.other.http-method.outry"
        }
      },
      "end": "(?=\\s+\\{|\\s*//)|$",
      "patterns": [
        {
          "include": "#strings"
        },
        {
          "include": "#interpolation"
        },
        {
          "match": "(\\{)\\s*([A-Za-z_][\\w]*)\\s*(\\})",
          "captures": {
            "1": {
              "name": "punctuation.definition.parameter.begin.outry"
            },
            "2": {
              "name": "variable.parameter.outry"
            },
            "3": {
              "name": "punctuation.definition.parameter.end.outry"
            }
          }
        },
        {
          "name": "string.unquoted.path.outry",
          "match": "[^\\s{$\"]+|\\$(?!\\{)"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(shape)\\s+([A-Za-z_][\\w]*)",
          "captures": {
            "1": {
              "name": "keyword.other.shape.outry"
            },
            "2": {
              "name": "entity.name.type.outry"
            }
          }
        },
        {
          "match": "\\b(flow)\\s+([A-Za-z_][\\w]*)",
          "captures": {
            "1": {
              "name": "keyword.other.flow.outry"
            },
            "2": {
              "name": "entity.name.function.outry"
            }
          }
        },
        {
          "match": "\\b(let)\\s+([A-Za-z_][\\w]*)",
          "captures": {
            "1": {
              "name": "storage.type.let.outry"
            },
            "2": {
              "name": "variable.other.declaration.outry"
            }
          }
        },
        {
          "match": "\\b(save)\\s+([A-Za-z_][\\w]*)(?=\\s*=)",
          "captures": {
            "1": {
              "name": "keyword.other.save.outry"
            },
            "2": {
              "name": "variable.other.declaration.outry"
            }
          }
        },
        {
          "match": "^\\s*(handler)\\s*(:)\\s*([\\w./-]+)",
          "captures": {
            "1": {
              "name": "keyword.other.field.outry"
            },
            "2": {
              "name": "punctuation.separator.key-value.outry"
            },
            "3": {
              "name": "entity.name.namespace.outry"
            }
          }
        }
      ]
    },
    "fields": {
      "comment": "Request fields at the start of a line: `headers {`, `body \"…\"`, `timeout: 5s`",
      "match": "^\\s*(handler|params|only|confirm|timeout|redirects|cache|query|headers|body|form|multipart)\\b(?=\\s*(?:[:{\\[\"']|file\\s*\\())",
      "captures": {
        "1": {
          "name": "keyword.other.field.outry"
        }
      }
    },
    "expression": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#regex"
        },
        {
          "name": "constant.numeric.duration.outry",
          "match": "\\b\\d+(?:\\.\\d+)?(?:ms|s|m|h)\\b"
        },
        {
          "name": "constant.numeric.outry",
          "match": "\\b\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.language.outry",
          "match": "\\b(?:true|false|null)\\b"
        },
        {
          "name": "keyword.control.outry",
          "match": "\\b(?:expect|save|poll|every|for|fresh|let|shape|flow)\\b"
        },
        {
          "name": "keyword.operator.word.outry",
          "match": "\\b(?:matches|in|typeof)\\b"
        },
        {
          "name": "support.type.property-name.outry",
          "match": "(?<![.\\w-])[A-Za-z_][\\w]*(?:-[\\w]+)*\\??(?=\\s*:(?!:))"
        },
        {
          "name": "support.function.builtin.outry",
          "match": "\\b(?:uuid|now|nowIso|randomInt|randomString|number|string|json|base64|unbase64|file|schema)(?=\\s*\\()"
        },
        {
          "name": "entity.name.function.call.outry",
          "match": "\\b[A-Z][\\w]*(?=\\s*\\()"
        },
        {
          "name": "support.type.primitive.outry",
          "match": "\\b(?:string|number|integer|boolean|any)\\b"
        },
        {
          "name": "entity.name.type.outry",
          "match": "\\b[A-Z][\\w]*\\b"
        },
        {
          "match": "(\\.)\\s*([A-Za-z_][\\w]*(?:-[\\w]+)*)(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "punctuation.accessor.outry"
            },
            "2": {
              "name": "entity.name.function.member.outry"
            }
          }
        },
        {
          "match": "(\\.)\\s*([A-Za-z_][\\w]*(?:-[\\w]+)*)",
          "captures": {
            "1": {
              "name": "punctuation.accessor.outry"
            },
            "2": {
              "name": "variable.other.property.outry"
            }
          }
        },
        {
          "name": "variable.language.outry",
          "match": "\\b(?:status|headers|body|duration|cookies|env|vars)\\b"
        },
        {
          "name": "variable.other.outry",
          "match": "\\b[a-z_][\\w]*\\b"
        },
        {
          "name": "keyword.operator.outry",
          "match": "==|!=|<=|>=|&&|\\|\\||=>|[<>=!+\\-*/%|?]"
        },
        {
          "name": "punctuation.separator.outry",
          "match": "[,:]"
        },
        {
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.block.begin.outry"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.block.end.outry"
            }
          },
          "patterns": [
            {
              "include": "#fields"
            },
            {
              "include": "#declarations"
            },
            {
              "include": "#expression"
            }
          ]
        }
      ]
    },
    "regex": {
      "match": "(?<=\\bmatches)\\s+(/(?:[^/\\\\\\n]|\\\\.)+/[a-z]*)",
      "captures": {
        "1": {
          "name": "string.regexp.outry"
        }
      }
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.outry",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "include": "#escape"
            },
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "name": "string.quoted.double.outry",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [
            {
              "include": "#escape"
            },
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "name": "string.quoted.single.outry",
          "begin": "'",
          "end": "'|$",
          "patterns": [
            {
              "include": "#escape"
            },
            {
              "include": "#interpolation"
            }
          ]
        }
      ]
    },
    "escape": {
      "name": "constant.character.escape.outry",
      "match": "\\\\."
    },
    "interpolation": {
      "name": "meta.embedded.interpolation.outry",
      "begin": "\\$\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.begin.outry"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.end.outry"
        }
      },
      "patterns": [
        {
          "include": "#expression"
        }
      ]
    }
  }
}
