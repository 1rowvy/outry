{
  "name": "outry-vscode",
  "displayName": "Outry API Client",
  "description": "Executable API specs in your repo: send .outry requests, check responses, keep them in sync with your Go routes.",
  "version": "0.10.0",
  "publisher": "outry",
  "license": "MIT",
  "icon": "media/icon.png",
  "homepage": "https://1rowvy.github.io/outry/guides/editors/#vs-code",
  "repository": {
    "type": "git",
    "url": "https://github.com/1rowvy/outry",
    "directory": "editors/vscode"
  },
  "bugs": "https://github.com/1rowvy/outry/issues",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Testing",
    "Other"
  ],
  "keywords": [
    "api",
    "http",
    "rest",
    "client",
    "testing",
    "go"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/*.outry",
    "workspaceContains:**/api/env.toml"
  ],
  "contributes": {
    "languages": [
      {
        "id": "outry",
        "aliases": [
          "Outry",
          "outry"
        ],
        "extensions": [
          ".outry"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./media/file.svg",
          "dark": "./media/file.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "outry",
        "scopeName": "source.outry",
        "path": "./syntaxes/outry.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "outry.send",
        "title": "Send Request",
        "category": "Outry",
        "icon": "$(play)"
      },
      {
        "command": "outry.sendIn",
        "title": "Send Request in Environment…",
        "category": "Outry"
      },
      {
        "command": "outry.copyCurl",
        "title": "Copy Request as curl",
        "category": "Outry"
      },
      {
        "command": "outry.selectEnvironment",
        "title": "Select Environment",
        "category": "Outry",
        "icon": "$(server-environment)"
      },
      {
        "command": "outry.refresh",
        "title": "Refresh",
        "category": "Outry",
        "icon": "$(refresh)"
      },
      {
        "command": "outry.restart",
        "title": "Restart Language Server",
        "category": "Outry"
      },
      {
        "command": "outry.showOutput",
        "title": "Show Output",
        "category": "Outry"
      }
    ],
    "keybindings": [
      {
        "command": "outry.send",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == outry"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "outry.send",
          "when": "editorLangId == outry"
        },
        {
          "command": "outry.sendIn",
          "when": "editorLangId == outry"
        },
        {
          "command": "outry.copyCurl",
          "when": "editorLangId == outry"
        }
      ],
      "editor/title/run": [
        {
          "command": "outry.send",
          "when": "resourceLangId == outry"
        }
      ],
      "editor/context": [
        {
          "command": "outry.send",
          "when": "editorLangId == outry",
          "group": "outry@1"
        },
        {
          "command": "outry.sendIn",
          "when": "editorLangId == outry",
          "group": "outry@2"
        },
        {
          "command": "outry.copyCurl",
          "when": "editorLangId == outry",
          "group": "outry@3"
        }
      ],
      "view/title": [
        {
          "command": "outry.selectEnvironment",
          "when": "view == outry.requests",
          "group": "navigation@1"
        },
        {
          "command": "outry.refresh",
          "when": "view == outry.requests || view == outry.variables",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "outry.send",
          "when": "view == outry.requests && viewItem =~ /^(request|flow)$/",
          "group": "inline"
        },
        {
          "command": "outry.send",
          "when": "view == outry.requests && viewItem =~ /^(request|flow)$/",
          "group": "1_run@1"
        },
        {
          "command": "outry.sendIn",
          "when": "view == outry.requests && viewItem =~ /^(request|flow)$/",
          "group": "1_run@2"
        },
        {
          "command": "outry.copyCurl",
          "when": "view == outry.requests && viewItem == request",
          "group": "2_copy@1"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "outry",
          "title": "Outry",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "outry": [
        {
          "id": "outry.requests",
          "name": "Requests"
        },
        {
          "id": "outry.variables",
          "name": "Variables"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "outry.requests",
        "contents": "No .outry requests in this workspace.\n[Read the format guide](https://1rowvy.github.io/outry/guides/request-format/)"
      }
    ],
    "configuration": {
      "title": "Outry",
      "properties": {
        "outry.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Path to the `outry` binary. Empty: the one bundled with the extension, then `outry` on `PATH`."
        },
        "outry.env": {
          "type": "string",
          "default": "",
          "markdownDescription": "Environment to start with. Empty: `default` from `env.toml`. Switching it in the status bar is remembered per workspace."
        },
        "outry.keyring": {
          "type": "boolean",
          "default": true,
          "description": "Read secrets from the system keychain."
        },
        "outry.import": {
          "type": "boolean",
          "default": true,
          "description": "Compare requests with the Go code and offer quick fixes."
        },
        "outry.goDir": {
          "type": "string",
          "default": "",
          "markdownDescription": "Folder with the Go code, relative to the workspace folder. Empty: the parent of `api/`, else the project folder."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs && vite build --config webview/vite.config.ts",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p webview",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run build",
    "test": "node test/run.mjs"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/vscode": "~1.91.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.4.0"
  }
}
