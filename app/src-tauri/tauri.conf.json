{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Routy",
  "identifier": "dev.rowvy.routy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Routy",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "API client where requests are plain files in your repo",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE2RkU3QzU5MkUzQjg3ODMKUldTRGh6c3VXWHorRmpsVVFjNEFhSjRyQnIrWFZJeFdTS1ZFdjlvVEN6Mm5WNEhCN1FCQUJIV3IK",
      "endpoints": [
        "https://github.com/1rowvy/routy/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
